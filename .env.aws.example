# ==============================================================================
# PickleMatch2K trên AWS (EC2 + RDS) - mẫu cấu hình cho docker-compose.aws.yml.
# Trên máy EC2:  cp .env.aws.example .env   rồi thay mọi giá trị <...>. Không commit file .env.
# ==============================================================================

ENVIRONMENT=production

# --- CSDL Amazon RDS for PostgreSQL ---
# ENDPOINT_RDS: tab "Connectivity & security" của CSDL trên RDS, mục Endpoint.
# Mật khẩu nằm trong URL: chỉ nên gồm chữ và số (ký tự đặc biệt phải mã hóa URL, ví dụ @ thành %40).
DATABASE_URL=postgresql://postgres:<MAT_KHAU_RDS>@<ENDPOINT_RDS>:5432/pickleball_db?sslmode=verify-full&sslrootcert=/certs/global-bundle.pem

# --- Bảo mật ---
# Tạo khóa ngẫu nhiên trên máy EC2: openssl rand -hex 32
SECRET_KEY=<KHOA_NGAU_NHIEN>
ACCESS_TOKEN_EXPIRE_MINUTES=1440
# Public IPv4 của máy EC2 với cổng 3000 và 3001. IP đổi (sau khi Stop rồi Start máy) thì sửa dòng này
# rồi chạy lại: docker compose -f docker-compose.aws.yml up -d
CORS_ORIGINS=http://<IP_EC2>:3000,http://<IP_EC2>:3001

# --- Lưu ảnh: local | cloudinary ---
# local: ảnh nằm trong volume Docker của riêng máy EC2 này; cloudinary: ảnh nằm trên Cloudinary, đổi máy chủ không mất
STORAGE_BACKEND=local
MAX_IMAGE_SIZE_MB=10
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- SePay VietQR ---
# Khi ENVIRONMENT=production, webhook SePay chỉ được nhận khi có khóa này
SEPAY_WEBHOOK_API_KEY=
SEPAY_BANK_NAME=
SEPAY_BANK_CODE=
SEPAY_BANK_ACCOUNT=
SEPAY_ACCOUNT_HOLDER=
# true: mọi cụm sân dùng chung tài khoản SEPAY_* ở trên; false: tài khoản riêng của từng chủ sân
SEPAY_UNIFIED_TEST_MODE=true
# true: hiện nút giả lập thanh toán - chỉ bật khi demo
SEPAY_SIMULATOR_ENABLED=false
