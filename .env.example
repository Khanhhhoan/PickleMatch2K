# ==============================================================================
# PickleMatch2K - mẫu cấu hình. Sao chép thành `.env` (không commit file .env).
# Backend đọc `.env` ở thư mục gốc và `backend/.env` (file sau ghi đè file trước).
# ==============================================================================

# development | production
ENVIRONMENT=development

# --- Cơ sở dữ liệu (PostgreSQL) ---
DATABASE_URL=postgresql://postgres:CHANGE_ME@localhost:5432/pickleball_db

# --- Chỉ dùng cho Docker Compose: CSDL riêng trong container, không phải PostgreSQL cài trên máy ---
POSTGRES_USER=postgres
# Chỉ dùng chữ và số (mật khẩu được ghép vào URL kết nối)
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=pickleball_db
# true: lần chạy đầu (CSDL trống) tự nạp dữ liệu demo, mọi tài khoản dùng mật khẩu 123456
SEED_DEMO_DATA=true

# --- Redis: giữ chỗ slot và giới hạn tần suất đăng nhập (bỏ trống = lưu trong bộ nhớ, chỉ hợp khi chạy 1 tiến trình) ---
REDIS_URL=redis://localhost:6379/0

# --- Bảo mật ---
# Tạo khóa: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=CHANGE_ME_TO_A_LONG_RANDOM_STRING
ACCESS_TOKEN_EXPIRE_MINUTES=1440
# Danh sách origin của frontend, cách nhau bằng dấu phẩy
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# --- Lưu ảnh: local | cloudinary ---
STORAGE_BACKEND=local
MAX_IMAGE_SIZE_MB=10
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- SePay VietQR ---
# Khóa xác thực webhook (bắt buộc khi ENVIRONMENT=production)
SEPAY_WEBHOOK_API_KEY=
SEPAY_BANK_NAME=
SEPAY_BANK_CODE=
SEPAY_BANK_ACCOUNT=
SEPAY_ACCOUNT_HOLDER=
# true: mọi cụm sân dùng chung tài khoản SEPAY_* ở trên; false: tài khoản riêng của từng chủ sân
SEPAY_UNIFIED_TEST_MODE=true
# Chỉ bật khi demo/kiểm thử: hiện nút giả lập thanh toán
SEPAY_SIMULATOR_ENABLED=false

# --- Frontend khi build bằng Docker (giá trị được nhúng vào mã lúc build) ---
# Để trống: trình duyệt tự gọi API ở cùng tên máy, cổng 8000 - mở được cả từ điện thoại trong mạng LAN.
# Chỉ đặt khi API nằm ở địa chỉ khác, ví dụ https://api.ten-mien.vn
# NEXT_PUBLIC_API_URL=
# NEXT_PUBLIC_WS_URL=
# NEXT_PUBLIC_ADMIN_URL=
# Khi chạy `npm run dev`, Next.js đọc biến từ frontend/.env.local và admin-portal/.env.local, không đọc file này.
